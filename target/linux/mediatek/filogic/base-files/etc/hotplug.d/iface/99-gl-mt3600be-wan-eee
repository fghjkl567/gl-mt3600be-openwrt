#!/bin/sh
# Disable Energy Efficient Ethernet on the GL-MT3600BE RTL8221B WAN PHY.
# Board mapping: WAN=eth0, LAN=eth1.
case "$ACTION" in
ifup|ifupdate) ;;
*) exit 0 ;;
esac

. /lib/functions.sh
[ "$INTERFACE" = "wan" ] || exit 0
[ "$(board_name)" = "glinet,gl-mt3600be" ] || exit 0

# Use the board's fixed WAN port, not a caller-supplied device name.
if ! /usr/sbin/ethtool --set-eee eth0 eee off >/dev/null 2>&1; then
	logger -t wan-eee "could not disable EEE on eth0 (driver/PHY may not support it)"
fi

exit 0
